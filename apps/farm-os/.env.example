# Supabase — point at the approved remote project or a Supabase branch.
# Copy this file to .env.local and fill in the real values. Never commit .env.local.
# Do not use the Docker-backed local Supabase stack for Farm OS.

# Public — safe to expose to the browser (anon key is RLS-scoped).
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — bypasses RLS. NEVER expose to the client or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only read credential for Settings > Website visitors. Never prefix with NEXT_PUBLIC_.
VERCEL_ANALYTICS_TOKEN=
# Vercel supplies VERCEL_PROJECT_ID and VERCEL_TEAM_ID automatically in deployments.
# Set these overrides only when querying another project or when running locally.
# VERCEL_ANALYTICS_PROJECT_ID=prj_...
# VERCEL_ANALYTICS_TEAM_ID=team_...

# Stage 9 weather (SPEC-0007) — server-only; the browser never sees these. Owner sets the provider.
# WEATHER_API_KEY=...
# WEATHER_API_URL=https://api.openweathermap.org/data/3.0/onecall?lat=..&lon=..&units=metric&exclude=minutely,hourly&appid={key}
